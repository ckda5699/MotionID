# ──────────────────────────────────────────────────────────────────────────────
# Motion ID — Root Environment Config
# Copy this file to .env and fill in values.
# .env is gitignored. This file is safe to commit.
# ──────────────────────────────────────────────────────────────────────────────

# ── App environment ───────────────────────────────────────────────────────────
# Values: local | staging | production
VITE_APP_ENV=local

# ── Data base URL ─────────────────────────────────────────────────────────────
# LOCAL: served from app/public/data/
VITE_DATA_BASE_URL=/data

# AWS (S3 direct or CloudFront): uncomment and set when using S3
# VITE_DATA_BASE_URL=https://d<id>.cloudfront.net/data

# ── Media base URL ────────────────────────────────────────────────────────────
# LOCAL: served from app/public/media/
VITE_MEDIA_BASE_URL=/media

# AWS (S3 direct or CloudFront): uncomment and set when using S3
# VITE_MEDIA_BASE_URL=https://d<id>.cloudfront.net/media

# ── Agentation (local dev AI overlay — disable on staging/prod) ───────────────
VITE_ENABLE_AGENTATION=true
# Set to false for staging/prod builds — the deploy script forces this automatically.

# ── AWS (pipeline scripts only — not used by the browser app) ─────────────────
# AWS_PROFILE=113725432743_slalom_IsbUsersPS
# AWS_REGION=eu-central-1
# AMPLIFY_APP_ID=d2atp4d3qd2js3
# AMPLIFY_BRANCH=staging

# ── SportsAPIPro (pipeline ingest only — never used in the browser) ───────────
# Set in shell only; do NOT commit real values here.
# SPORTSAPIPRO_API_KEY=<your-key>
