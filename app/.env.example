# ──────────────────────────────────────────────────────────────────────────────
# Motion ID App — Vite Environment Config
# Copy this file to app/.env and fill in values.
# app/.env is gitignored. This file is safe to commit.
# ──────────────────────────────────────────────────────────────────────────────

# LOCAL mode — assets served from app/public/
VITE_APP_ENV=local
VITE_DATA_BASE_URL=/data
VITE_MEDIA_BASE_URL=/media
VITE_ENABLE_AGENTATION=true

# AWS mode — uncomment and set when pointing at S3/CloudFront
# VITE_APP_ENV=staging
# VITE_DATA_BASE_URL=https://d<id>.cloudfront.net/data
# VITE_MEDIA_BASE_URL=https://d<id>.cloudfront.net/media
# VITE_ENABLE_AGENTATION=false
