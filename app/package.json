{
  "name": "motion-id-stage-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "dev:lan": "vite --host 0.0.0.0 --port 5177",
    "build": "vite build",
    "prepare:content": "python ../scripts/prepare_motion_id_content.py",
    "ingest:players": "python ../scripts/ingest_player_profiles.py",
    "ingest:bundesliga": "python ../scripts/ingest_player_profiles.py --scope bundesliga --max-requests 40",
    "ingest:bundesliga:details": "python ../scripts/ingest_player_profiles.py --scope bundesliga --enrich-details --max-requests 90",
    "preview": "vite preview --host 127.0.0.1 --port 5178",
    "preview:lan": "vite preview --host 0.0.0.0 --port 5178"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "agentation": "^3.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {}
}
